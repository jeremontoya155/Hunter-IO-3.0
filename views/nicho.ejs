<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Nicho</title>
    
    <link rel="stylesheet" href="/static/css/nichos.css">
    <link rel="stylesheet" href="/static/css/navbar.css">
    

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="/static/js/navbar.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <h2>Registrar Nicho</h2>

        <!-- Formulario -->
        <form id="nichoForm" action="/nicho" method="POST" enctype="multipart/form-data">
            <label for="ubicacion">Ubicación:</label>
            <input type="text" id="ubicacion" name="ubicacion" required>

            <label for="tipo_personas">Instagram (separados por coma):</label>
            <textarea id="tipo_personas" name="tipo_personas" required></textarea>

            <label for="edad_min">Edad Mínima:</label>
            <input type="number" id="edad_min" name="edad_min">

            <label for="edad_max">Edad Máxima:</label>
            <input type="number" id="edad_max" name="edad_max">

            <label for="mensaje">Mensaje:</label>
            <textarea id="mensaje" name="mensaje" required></textarea>

            <div class="upload-container">
                <label for="archivo_pdf">Subir PDF (Opcional):</label>
                <input type="file" id="archivo_pdf" name="archivo_pdf" accept=".pdf" class="file-input">
            </div>

            <button type="submit">Guardar Nicho</button>
        </form>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
          const form = document.getElementById("nichoForm");

          form.addEventListener("submit", function (event) {
              event.preventDefault(); // Evita que la página se recargue al enviar

              const formData = new FormData(form);

              fetch("/nicho", {
                  method: "POST",
                  body: formData
              })
              .then(response => response.json())
              .then(data => {
                  if (data.success) {
                      alert("✅ Nicho registrado correctamente.");
                      form.reset(); // Limpia el formulario
                  } else {
                      alert("❌ Hubo un error al registrar el nicho.");
                  }
              })
              .catch(error => {
                  console.error("Error al enviar el formulario:", error);
                  alert("⚠️ Error en la solicitud. Inténtelo de nuevo.");
              });
          });
      });
    </script>
</body>
</html>
