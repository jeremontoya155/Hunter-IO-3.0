<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Nicho</title>
    <link rel="stylesheet" href="/static/css/nichos.css">
    <link rel="stylesheet" href="/static/css/navbar.css">
    <link rel="stylesheet" href="static/css/scrollbar.css" />
    <!-- Agregamos FontAwesome para íconos -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <link rel="stylesheet" href="static/css/navbar.css" />
    <link rel="stylesheet" href="static/css/scrollbar.css" />
    <script src="static/js/navbar.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <h2>Registrar Nicho</h2>

     
        <form action="/nicho" method="POST" enctype="multipart/form-data">
            <label for="ubicacion">Ubicación:</label>
            <input type="text" id="ubicacion" name="ubicacion" required>

            <label for="tipo_personas">Intagram(separados por coma):</label>
            <textarea id="tipo_personas" name="tipo_personas" required></textarea>

            <label for="edad_min">Edad Mínima:</label>
            <input type="number" id="edad_min" name="edad_min">

            <label for="edad_max">Edad Máxima:</label>
            <input type="number" id="edad_max" name="edad_max">

            <label for="mensaje">Mensaje:</label>
            <textarea id="mensaje" name="mensaje" required></textarea>

            <div class="upload-container">
                <label for="archivo_pdf">Subir PDF (Opcional):</label>
                <input type="file" id="archivo_pdf" name="archivo_pdf" accept=".pdf" class="file-input">
            </div>

            <button type="submit">Guardar Nicho</button>
        </form>
    </div>
</body>
</html>