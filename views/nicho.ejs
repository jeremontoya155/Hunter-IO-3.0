<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hunter Suite - Home ✨</title>
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/static/css/nichos.css" />
    <link rel="stylesheet" href="/static/css/navbar.css" />
    <link rel="stylesheet" href="/static/css/scrollbar.css" />
    <link rel="stylesheet" href="/static/css/all.css" />
    <link rel="stylesheet" href="/static/css/variables.css" />

    <!-- FontAwesome for icons -->
    <link 
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <!-- Google Fonts (Poppins) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script src="/static/js/navbar.js" defer></script>
    <script src="/static/js/languagesDefine/nichoLang.js" type="module"></script>
    <script src="/static/js/file-input-label.js" defer></script>
  </head>
  <body>
    <!-- Navbar included -->
    <%- include('partials/navbar') %>
    
    <!-- Selector de Idioma -->
    <div class="language-switcher">
      <button id="btn-es" class="lang-btn active" onclick="changeLanguage('es')">
        <span>SP</span>
      </button>
      <div class="separator"></div>
      <button id="btn-en" class="lang-btn" onclick="changeLanguage('en')">
        <span>EN</span>
      </button>
    </div>

    <!-- Initial Selection Container -->
     <div class="choice-wrapper">

       <div class="choice-container" id="choice-container">
         <div class="choice-card" data-target="hunter-form-section">
           <img src="/static/images/flecha.ico" alt="Arrow" class="icon-choice" width="45" height="45" />
           <h3 data-translate-key="createArrow">Crea tu Flecha</h3>
           <p data-translate-key="arrowDesc">Configura una nueva instancia de Hunter para empezar.</p>
         </div>
   
         <div class="choice-card" data-target="arco-form-section">
           <img src="/static/images/arco.ico" alt="Bow" class="icon-choice" width="45" height="45" />
           <h3 data-translate-key="createBow">Crea tu Arco</h3>
           <p data-translate-key="bowDesc">Configura un nuevo lanzador para tus campañas.</p>
         </div>
         <!-- MODIFIED: This data-target is no longer used to show a form, but is kept for JS card identification -->
         <div class="choice-card" data-target="blanco-form-section">
           <img src="/static/images/blanco.ico" alt="Target" class="icon-choice" width="45" height="45" />
           <h3 data-translate-key="createTarget">Crea tu Blanco</h3>
           <p data-translate-key="targetDesc">Define un nuevo nicho objetivo con sus características.</p>
         </div>
   
         <div class="choice-card" data-target="mind-form-section" id="mind-card">
           <img src="/static/images/brain.png" alt="Mind" class="icon-choice" width="45" height="45" />
           <h3 data-translate-key="createMind">Crea tu Mente</h3>
           <p data-translate-key="mindDes">Configura tu Mente Hunter para estrategias avanzadas.</p>
         </div>
       </div>
     </div>

    <!-- "Create Hunter" Form Section (Initially Hidden) -->
    <section id="hunter-form-section" class="form-section">
      <div class="form-container">
        <div class="form-card">
          <h2>
            <i class="/static/images/arco.ico"></i> <span data-translate-key="uploadMessages">CARGA TU LISTA DE MENSAJES</span>
          </h2>
          <p class="subtitle" data-translate-key="startHunt">Inicia una nueva caza.</p>

          <form
            action="/api/flecha/mensajes"
            method="POST"
            class="hunter-form"
            id="hunter-form"
          >
            <div class="form-group">
              <label for="mensajes"
                ><i class="fas fa-signature"></i> <span data-translate-key="arrowsLabel">Arrows:</span></label
              >
              <textarea
                id="mensajes"
                name="mensajes"
                placeholder="Ex: Message1&#10;Message2"
                required
                rows="5"
              ></textarea>
              <small data-translate-key="arrowsSmall" data-html="true">Recordá insertar las <strong><em>flechas</em></strong> con salto de lineas</small>
            </div>

            <div class="form-actions">
              <button
                type="button"
                class="back-button"
                data-action="show-choice"
              >
                <i class="fas fa-arrow-left"></i> <span data-translate-key="backButton">Volver</span>
              </button>
              <button type="submit" class="submit-button">
                <i class="fas fa-cogs"></i> <span data-translate-key="startHunterButton">Iniciar Hunter</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- "Create your Target" Form Section (Initially Hidden) -->
    <!-- Although this section exists in the HTML, the modified script now redirects instead of showing it -->
    <!-- Consider removing this section and its form script if the /targets page now handles it completely -->
    <section id="blanco-form-section" class="form-section">
      <!-- The content of this form will no longer be shown on this page when clicking "Create your Target" -->
      <!-- If you need this form, it should be on the /targets page -->
      <div class="form-container">
        <div class="form-card">
          <h2>
            <i class="fas fa-bullseye icon-title"></i> <span data-translate-key="newTargetRegister">Registrar Nuevo Target</span>
          </h2>
          <p class="subtitle" data-translate-key="newTargetRegisterDesc">Define los detalles de tu público objetivo.</p>

          <!-- Form modified to use JSON -->
          <form id="nicho-form" class="nicho-form">
            <div class="form-group">
              <label for="ubicacion"
                ><i class="fas fa-map-marker-alt"></i> <span data-translate-key="location">Ubicación:</span></label
              >
              <input
                type="text"
                id="ubicacion"
                name="ubicacion"
                placeholder="Ex: Mexico City, Remote"
                required
              />
            </div>

            <div class="form-group">
              <label for="tipo_personas"
                ><i class="fas fa-lightbulb"></i> <span data-translate-key="interests">Intereses (separados por coma):</span></label
              >
              <textarea
                id="tipo_personas"
                name="tipo_personas"
                placeholder="Ex: Web development, Digital marketing, Sustainable travel"
                required
                rows="3"
              ></textarea>
            </div>

            <div class="form-row">
              <div class="form-group half-width">
                <label for="edad_min"
                  ><i class="fas fa-arrow-down-1-9"></i> <span data-translate-key="ageMin">Edad Mínima:</span></label
                >
                <input
                  type="number"
                  id="edad_min"
                  name="edad_min"
                  placeholder="Ex: 21"
                  min="0"
                />
              </div>
              <div class="form-group half-width">
                <label for="edad_max"
                  ><i class="fas fa-arrow-up-9-1"></i> <span data-translate-key="ageMax">Edad Máxima:</span></label
                >
                <input
                  type="number"
                  id="edad_max"
                  name="edad_max"
                  placeholder="Ex: 45"
                  min="0"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="cuentas"
                ><i class="fas fa-envelope-open-text"></i> <span data-translate-key="targetsAccounts">Cuentas Objetivo:</span></label
              >
              <textarea
                id="cuentas"
                name="cuentas"
                placeholder="Enter accounts similar to your niches, one per line"
                required
                rows="4"
              ></textarea>
              <small data-translate-key="noteDesc">Separá cada cuenta con un salto de línea</small>
            </div>

            <div class="form-actions">
              <button
                type="button"
                class="back-button"
                data-action="show-choice"
              >
                <i class="fas fa-arrow-left"></i> <span data-translate-key="backButton">Volver</span>
              </button>
              <button type="submit" class="submit-button">
                <i class="fas fa-save"></i> <span data-translate-key="saveButton">Guardar Target</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <script defer src="/static/js/nicho.js"></script>

  </body>
</html>
