<!DOCTYPE html>
<html lang="en">
  <!-- Idioma por defecto: Inglés (JS lo cambiará si hay preferencia guardada) -->
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Título se establecerá dinámicamente por JS -->
    <title>HUNTER - Welcome and First Steps</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- FontAwesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Estilos Externos -->
    <link rel="stylesheet" href="/static/css/navbar.css" />
    <!-- NUEVO: onboarding.css contendrá todos los estilos de esta página -->
    <!-- <link rel="stylesheet" href="/static/css/onboarding.css" /> -->
    <link rel="stylesheet" href="/static/css/onboarding2.css" />
    <link rel="stylesheet" href="/static/css/scrollbar.css" />

    <!-- Estilos Internos (SOLO si necesitas sobreescribir algo muy específico, idealmente vacío) -->
    <style>
      /* Mantener estilos muy locales si es estrictamente necesario,
           idealmente mover todo a onboarding.css */
    </style>

    <!-- Script Navbar (Asegúrate que esta ruta es correcta) -->
    <script defer src="/static/js/navbar.js"></script>

    <!-- Script Principal (Acordeón, Completado POR TAREA, Habilitación Secuencial, Idioma) -->
    <script defer src="/static/js/onboarding.js"></script>
  </head>
  <body>
    <!-- Incluir Navbar (Asegúrate que el partial exista y funcione) -->
    <!-- Esto puede necesitar un wrapper div si tu navbar es fixed y afecta el padding del body -->
    <%- include('partials/navbar') %>

    <!-- Selector de Idioma -->
    <div class="language-switcher">
      <button id="btn-es" class="lang-btn" onclick="changeLanguage('es')">
        <span>SP</span>
      </button>
      <div class="separator"></div>
      <button id="btn-en" class="lang-btn" onclick="changeLanguage('en')">
        <span>EN</span>
      </button>
    </div>

    <!-- Contenido Principal del Onboarding -->
    <div class="onboarding-background">
      <div class="onboarding-container">
        <!-- NUEVO: Encabezado con Logo y Texto -->
        <header class="onboarding-header-content">
          <div class="logo-container">
            <!-- Asegúrate de que logoWeb.png está en /static/images -->
            <img
              src="/static/images/logoWeb.png"
              alt="Hunter Logo"
              class="hunter-logo"
            />
          </div>
          <div class="header-text-container">
            <!-- h1 se llena con JS -->
            <h1 id="main-heading"><!-- JS lo llenará --></h1>
          </div>
        </header>

        <!-- Pasos del Onboarding (Acordeón) -->
        <main class="onboarding-content">
          <!-- Paso 1 -->
          <section class="onboarding-step" id="step-1-section">
            <!-- data-step es crucial para el JS -->
            <div class="step-header" data-step="1">
              <span class="step-number">1</span>
              <h2 id="step1-title" class="step-title"><!-- JS llenará --></h2>
              <span class="step-icon"
                ><i class="fas fa-chevron-right"></i
              ></span>
              <!-- Checkbox global ELIMINADO del header -->
            </div>
            <div class="step-body">
              <div class="step-body-content">
                <p id="step1-intro"><!-- JS llenará --></p>
                <!-- CAMBIADO a UL con clase feature-list -->
                <ul id="step1-list" class="feature-list">
                  <!-- JS llenará con LI > INPUT + LABEL -->
                </ul>
                <!-- Enlace tutorial: href debe apuntar a tu video real -->
                <p>
                  <a
                    id="tutorial-link-1"
                    href="#"
                    class="tutorial-link"
                    target="_blank"
                    ><i class="fas fa-video"></i>
                    <span><!-- JS llenará --></span></a
                  >
                </p>
              </div>
            </div>
          </section>

          <!-- Paso 2 (Inicialmente deshabilitado por JS si Paso 1 no está completo) -->
          <section class="onboarding-step" id="step-2-section">
            <div class="step-header" data-step="2">
              <span class="step-number">2</span>
              <h2 id="step2-title" class="step-title"><!-- JS llenará --></h2>
              <span class="step-icon"
                ><i class="fas fa-chevron-right"></i
              ></span>
              <!-- Checkbox global ELIMINADO -->
            </div>
            <div class="step-body">
              <div class="step-body-content">
                <p id="step2-intro"><!-- JS llenará --></p>
                <!-- Ya usaba UL con feature-list -->
                <ul id="step2-list" class="feature-list">
                  <!-- JS llenará con LI > INPUT + LABEL -->
                </ul>
                <!-- Enlace tutorial: href debe apuntar a tu video real -->
                <p>
                  <a
                    id="tutorial-link-2"
                    href="#"
                    class="tutorial-link"
                    target="_blank"
                    ><i class="fas fa-video"></i>
                    <span><!-- JS llenará --></span></a
                  >
                </p>
              </div>
            </div>
          </section>

          <!-- Paso 3 (Inicialmente deshabilitado por JS si Paso 1 o 2 no están completos) -->
          <section class="onboarding-step" id="step-3-section">
            <div class="step-header" data-step="3">
              <span class="step-number">3</span>
              <h2 id="step3-title" class="step-title"><!-- JS llenará --></h2>
              <span class="step-icon"
                ><i class="fas fa-chevron-right"></i
              ></span>
              <!-- Checkbox global ELIMINADO -->
            </div>
            <div class="step-body">
              <div class="step-body-content">
                <p id="step3-intro"><!-- JS llenará --></p>
                <!-- Ya usaba UL con feature-list -->
                <ul id="step3-list" class="feature-list">
                  <!-- JS llenará con LI > INPUT + LABEL -->
                </ul>
                <!-- Enlace tutorial: href debe apuntar a tu video real -->
                <p>
                  <a
                    id="tutorial-link-3"
                    href="#"
                    class="tutorial-link"
                    target="_blank"
                    ><i class="fas fa-video"></i>
                    <span><!-- JS llenará --></span></a
                  >
                </p>
              </div>
            </div>
          </section>
        </main>

        <!-- Pie de Página con Contacto -->
        <footer class="onboarding-footer">
          <p id="footer-cta" class="cta-footer"><!-- JS llenará --></p>
          <!-- NUEVO: Enlace de contacto -->
          <div class="contact-link-container">
            <!-- href debe apuntar a tu página de contacto real -->
            <a
              id="contact-link"
              href="https://hunterai.net/"
              class="contact-link"
              target="_blank"
              ><!-- JS llenará --></a
            >
          </div>
        </footer>
      </div>
      <!-- Fin .onboarding-container -->
    </div>
    <!-- Fin .onboarding-background -->
  </body>
</html>
