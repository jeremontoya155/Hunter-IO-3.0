<!DOCTYPE html>
<html lang="en"> <!-- Idioma por defecto: Inglés -->
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HUNTER - Welcome and First Steps</title> <!-- Título en Inglés -->

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Estilos Externos -->
    <link rel="stylesheet" href="/static/css/navbar.css" /> <!-- Asegúrate que esta ruta es correcta -->
    <link rel="stylesheet" href="/static/css/onboarding.css" /> <!-- Asegúrate que esta ruta es correcta -->
    <link rel="stylesheet" href="/static/css/scrollbar.css" /> <!-- Asegúrate que esta ruta es correcta -->

    <!-- Estilos Internos (Completos y con Footer ajustado) -->
    <style>
      /* --- Estilos Generales y Contenedores --- */
      body {
          font-family: 'Poppins', sans-serif;
          /* background-color: #1a1a2e; */ /* Asegúrate que el fondo se define aquí o en CSS externo */
          color: #e0e0e0;
           margin: 0;
      }
      .onboarding-background {
          padding: 80px 20px 40px;
          min-height: 100vh;
          box-sizing: border-box;
           /* Asegúrate que el fondo (color o imagen) esté definido aquí o en onboarding.css */
      }
      .onboarding-container {
          max-width: 900px;
          margin: 0 auto;
          background-color: rgba(0, 0, 0, 0.65);
          padding: 30px 40px;
          border-radius: 15px;
          box-shadow: 0 5px 20px rgba(0,0,0,0.3);
      }
      header {
          margin-bottom: 40px;
          /* Si tenías animación aquí y la quieres quitar, asegúrate de que no esté */
          /* opacity: 1; animation: none; */
      }

      /* --- Estilos Título Principal (Versión Corregida y Solicitada) --- */
      #main-heading {
          font-size: 3.2em; /* Tamaño base grande */
          line-height: 1.25;
          margin-bottom: 35px; /* Más espacio debajo */
          color: #ffffff; /* Color por defecto si no aplica a hijos */
          text-align: center;
      }
      #main-heading .intro-text { /* "WELCOME TO" */
          font-size: 0.75em;  /* Relativo al h1, más grande que el original */
          font-weight: 600;   /* Un poco más grueso */
          text-transform: uppercase; /* Mayúsculas */
          letter-spacing: 1.5px;   /* Espaciado entre letras */
          color: #e0e0e0;         /* Color claro */
          opacity: 0.9;
          display: block;      /* Poner en su propia línea */
          margin-bottom: 8px;  /* Espacio antes de HUNTER */
      }
      #main-heading .highlight { /* "HUNTER" */
          font-weight: 700;    /* Grueso */
          display: block;      /* Asegurar su propia línea */
          color: #2ecc71;      /* Color VERDE principal */
          /* Efecto Brillo VERDE */
          text-shadow: 0 0 12px rgba(46, 204, 113, 0.7), /* Brillo principal */
                       0 0 25px rgba(46, 204, 113, 0.5); /* Brillo más difuso */
      }
      .slogan { /* Eslogan debajo */
          display: block;
          font-size: 0.5em; /* Relativo al h1 (ajustar si se ve muy pequeño) */
          font-weight: 400;
          margin-top: 12px; /* Espacio después de HUNTER */
          opacity: 0.75;
          color: #bdc3c7; /* Color del eslogan */
      }

      /* --- Estilos Acordeón --- */
      .onboarding-step {
          background-color: rgba(255, 255, 255, 0.05);
          margin-bottom: 15px;
          border-radius: 10px;
          border: 1px solid rgba(255, 255, 255, 0.1);
          overflow: hidden;
      }
      .step-header {
          display: flex;
          align-items: center;
          padding: 15px 20px;
          cursor: pointer;
          transition: background-color 0.3s ease;
          position: relative;
      }
      .step-header:hover { background-color: rgba(255, 255, 255, 0.1); }
      .step-header .step-number {
          background-color: #3498db;
          color: white;
          border-radius: 50%;
          width: 30px;
          height: 30px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-weight: 600;
          margin-right: 15px;
          flex-shrink: 0;
           transition: background-color 0.3s ease;
      }
      .step-header .step-title {
          flex-grow: 1;
          margin: 0;
          font-size: 1.2em;
          font-weight: 600;
          color: #ffffff;
           transition: opacity 0.3s ease, text-decoration 0.3s ease;
      }
      .step-header .step-icon {
          margin-left: auto;
          transition: transform 0.3s ease;
          font-size: 1.1em;
          padding-left: 15px;
          color: #bdc3c7;
      }
      .step-header .completion-checkbox {
          margin-left: 10px;
          transform: scale(1.3);
          cursor: pointer;
          vertical-align: middle;
      }
      .step-body {
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.4s ease-out, padding 0.4s ease-out;
           padding: 0 20px 0 65px;
      }
      .step-body.expanded {
          max-height: 600px;
           padding: 15px 20px 20px 65px;
          transition: max-height 0.4s ease-in, padding 0.4s ease-in;
      }
      .step-body-content {
           border-top: 1px solid rgba(255, 255, 255, 0.1);
           padding-top: 15px;
      }
      .step-body-content p, .step-body-content ul, .step-body-content ol {
          margin-bottom: 15px;
          color: #bdc3c7;
          line-height: 1.6;
      }
      .step-body-content strong { color: #ecf0f1; font-weight: 600; }
      .step-body-content ol, .step-body-content ul { padding-left: 20px; }
      .tutorial-link { display: inline-block; margin-top: 15px; font-size: 0.9em; color: #3498db; text-decoration: none; font-weight: 500; }
      .tutorial-link i { margin-right: 5px; }
      .tutorial-link:hover { text-decoration: underline; color: #5dade2; }

      /* --- Estilos Paso Completado y Expandido --- */
      .onboarding-step.completed .step-header .step-title { text-decoration: line-through; opacity: 0.6; }
      .onboarding-step.completed .step-header .step-number { background-color: #2ecc71; }
      .onboarding-step .step-header .step-icon.expanded-icon { transform: rotate(90deg); }

      /* --- Estilos Selector de Idioma --- */
      .language-switcher {
          position: fixed; top: 20px; right: 20px; z-index: 1000;
          display: flex; align-items: center; gap: 5px;
          background-color: rgba(44, 62, 80, 0.85); padding: 6px 12px;
          border-radius: 20px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
          backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
      }
      .language-switcher .lang-btn {
          background: none; border: none; color: #ecf0f1; cursor: pointer;
          font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 600;
          padding: 4px 8px; border-radius: 15px; transition: all 0.3s ease;
          opacity: 0.6; display: flex; align-items: center;
      }
      .language-switcher .lang-btn.active { opacity: 1; }
      .language-switcher .lang-btn:not(.active):hover { opacity: 0.85; background-color: rgba(255, 255, 255, 0.1); }
      .language-switcher .separator { width: 1px; height: 16px; background-color: rgba(255, 255, 255, 0.3); }
      .language-switcher .lang-btn span { line-height: 1; }

      /* --- Estilos Footer (Simplificado) --- */
      .onboarding-footer {
          margin-top: 40px;
          text-align: center;
          padding-top: 20px;
          border-top: 1px solid rgba(255, 255, 255, 0.1);
      }
      .onboarding-footer .cta-footer {
          font-weight: 600;
          color: #ffffff;
          margin-top: 0;
          font-size: 1.1em;
          line-height: 1.6;
      }
      .onboarding-footer .cta-footer i {
          color: #e74c3c;
          margin: 0 8px;
          vertical-align: middle;
      }
</style>
    <!-- Script Navbar -->
    <script defer src="/static/js/navbar.js"></script> <!-- Asegúrate que esta ruta es correcta -->

    <!-- Script Principal (Acordeón, Completado, Idioma) -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // ============================================
            //   TEXTOS (Footer simplificado)
            // ============================================
            const spanishElements = {
                title: "HUNTER - Bienvenida y Primeros Pasos", mainHeading: "<span class='intro-text'>Bienvenido a</span> <span class='highlight'>HUNTER</span><span class='slogan'>Donde no esperamos oportunidades — las creamos y las cazamos</span>",
                step1Title: "Inicia Sesión y Desbloquea el Poder", step1Intro: "Para comenzar tu cacería de resultados, sigue estos pasos:", step1List: ["<strong>Accede a Instagram:</strong> Introduce tus credenciales de forma segura.", "<strong>Mensajes Personalizados:</strong> Sube tu archivo con mensajes irresistibles.", "<strong>Preguntas Clave:</strong> Define las preguntas que activarán tu estrategia.", "<strong>Lista de Objetivos:</strong> Carga tu archivo con las cuentas a contactar.", "<strong>¡Inicia Sesión!:</strong> Presiona el botón y deja que HUNTER haga su magia."], step1TutorialLinkText: "Ver Tutorial Paso 1",
                step2Title: "Explora tu Centro de Mando: El Dashboard", step2Intro: "Una vez dentro, el <strong>DASHBOARD</strong> será tu torre de control:", step2List: ["<strong>Métricas Clave:</strong> Visualiza mensajes enviados y rendimiento al instante.", "<strong>Estadísticas Precisas:</strong> Entiende qué funciona y optimiza tu enfoque.", "<strong>Actividad y Crecimiento:</strong> Observa el impacto directo en tu perfil."], step2TutorialLinkText: "Ver Tutorial Paso 2",
                step3Title: "Navega con Agilidad: Panel Lateral", step3Intro: "El panel lateral izquierdo es tu arsenal de herramientas:", step3List: ["<strong>Dashboard:</strong> Tu vista principal, siempre accesible.", "<strong>Perfil y Análisis:</strong> Profundiza en el crecimiento y la interacción.", "<strong>Configuración:</strong> Personaliza HUNTER a tu medida."], step3TutorialLinkText: "Ver Tutorial Paso 3",
                footerCta: "<i class='fas fa-fighter-jet'></i> Tus metas son nuestro blanco <i class='fas fa-fighter-jet'></i>" // Solo CTA
            };
            const englishElements = {
                title: "HUNTER - Welcome and First Steps", mainHeading: "<span class='intro-text'>Welcome to</span> <span class='highlight'>HUNTER</span><span class='slogan'>Where we don't wait for opportunities — we create and hunt them</span>",
                step1Title: "Log In and Unlock the Power", step1Intro: "To start your results hunt, follow these steps:", step1List: ["<strong>Access Instagram:</strong> Enter your credentials securely.", "<strong>Customized Messages:</strong> Upload your file with irresistible messages.", "<strong>Key Questions:</strong> Define the questions that will activate your strategy.", "<strong>Target List:</strong> Load your file with accounts to contact.", "<strong>Log In!</strong> Press the button and let HUNTER work its magic."], step1TutorialLinkText: "Watch Step 1 Tutorial",
                step2Title: "Explore your Command Center: The Dashboard", step2Intro: "Once inside, the <strong>DASHBOARD</strong> will be your control tower:", step2List: ["<strong>Key Metrics:</strong> Visualize sent messages and performance instantly.", "<strong>Precise Statistics:</strong> Understand what works and optimize your approach.", "<strong>Activity and Growth:</strong> Observe the direct impact on your profile."], step2TutorialLinkText: "Watch Step 2 Tutorial",
                step3Title: "Navigate with Agility: Side Panel", step3Intro: "The left side panel is your toolkit arsenal:", step3List: ["<strong>Dashboard:</strong> Your main view, always accessible.", "<strong>Profile and Analysis:</strong> Dive deep into growth and interaction.", "<strong>Settings:</strong> Customize HUNTER to your measure."], step3TutorialLinkText: "Watch Step 3 Tutorial",
                footerCta: "<i class='fas fa-fighter-jet'></i> Your goals are our target <i class='fas fa-fighter-jet'></i>" // Solo CTA
            };

            // ============================================
            //   MANEJO DEL ESTADO (localStorage)
            // ============================================
            const storageKeys = { expanded: 'hunterOnboardingExpandedSteps', completed: 'hunterOnboardingCompletedSteps', language: 'preferredLanguage' };
            function getStoredState(key, defaultValue) { try { const stored = localStorage.getItem(key); if (stored === null) return defaultValue; return JSON.parse(stored); } catch (e) { console.error(`Error reading state (${key}):`, e); return defaultValue; } }
            function saveState(key, state) { try { localStorage.setItem(key, JSON.stringify(state)); } catch (e) { console.error(`Error saving state (${key}):`, e); } }
            let expandedState = getStoredState(storageKeys.expanded, {});
            let completedState = getStoredState(storageKeys.completed, {});

            // ============================================
            //   LÓGICA DEL ACORDEÓN Y COMPLETADO
            // ============================================
             const steps = document.querySelectorAll('.onboarding-step');
             steps.forEach(step => {
                 const header = step.querySelector('.step-header');
                 const body = step.querySelector('.step-body');
                 const checkbox = step.querySelector('.completion-checkbox');
                 const stepNumber = header?.dataset.step;
                 const arrowIcon = header?.querySelector('.step-icon');
                 if (!header || !body || !checkbox || !stepNumber) { return; }
                 if (expandedState[stepNumber]) { body.classList.add('expanded'); if (arrowIcon) arrowIcon.classList.add('expanded-icon'); }
                 if (completedState[stepNumber]) { step.classList.add('completed'); checkbox.checked = true; }
                 header.addEventListener('click', (e) => {
                     if (e.target === checkbox || e.target.tagName === 'INPUT') return; // Prevenir si se clickea el checkbox
                     const isExpanded = body.classList.toggle('expanded');
                     if (arrowIcon) arrowIcon.classList.toggle('expanded-icon', isExpanded);
                     expandedState[stepNumber] = isExpanded;
                     saveState(storageKeys.expanded, expandedState);
                 });
                 checkbox.addEventListener('change', () => {
                     const isCompleted = checkbox.checked;
                     step.classList.toggle('completed', isCompleted);
                     completedState[stepNumber] = isCompleted;
                     saveState(storageKeys.completed, completedState);
                 });
             });

            // ============================================
            //   FUNCIÓN PARA CAMBIAR IDIOMA
            // ============================================
            window.changeLanguage = function(lang) {
                if (lang !== 'es' && lang !== 'en') { return; }
                const elements = lang === 'es' ? spanishElements : englishElements;

                // --- Actualizar Textos ---
                document.title = elements.title;
                document.documentElement.setAttribute('lang', lang);
                document.getElementById('main-heading').innerHTML = elements.mainHeading;
                ['1', '2', '3'].forEach(num => {
                     const titleEl = document.getElementById(`step${num}-title`);
                     const introEl = document.getElementById(`step${num}-intro`);
                     const listEl = document.getElementById(`step${num}-list`);
                     const tutorialLinkEl = document.getElementById(`tutorial-link-${num}`);
                     if (titleEl) titleEl.textContent = elements[`step${num}Title`];
                     if (introEl) introEl.innerHTML = elements[`step${num}Intro`];
                     if (listEl) {
                         const currentListItems = listEl.children;
                         const newListData = elements[`step${num}List`];
                         newListData.forEach((item, index) => {
                             if (currentListItems[index]) {
                                 const iconHTML = currentListItems[index].querySelector('i')?.outerHTML || '';
                                 currentListItems[index].innerHTML = `${iconHTML} ${item}`;
                             } else {
                                 const newLi = document.createElement('li');
                                 const defaultIconHTML = ''; // Podrías definir iconos por defecto si los necesitas
                                 newLi.innerHTML = `${defaultIconHTML} ${item}`;
                                 listEl.appendChild(newLi);
                             }
                         });
                         while (listEl.children.length > newListData.length) { listEl.removeChild(listEl.lastChild); }
                     }
                     if (tutorialLinkEl) tutorialLinkEl.innerHTML = `<i class="fas fa-video"></i> ${elements[`step${num}TutorialLinkText`]}`;
                });

                // --- Actualizar Footer (solo cta) ---
                const footerCtaEl = document.getElementById('footer-cta');
                if (footerCtaEl) { footerCtaEl.innerHTML = elements.footerCta; }

                // --- Actualizar Botones Idioma ---
                const btnEs = document.getElementById('btn-es');
                const btnEn = document.getElementById('btn-en');
                if (btnEs && btnEn) {
                    btnEs.classList.toggle('active', lang === 'es');
                    btnEn.classList.toggle('active', lang === 'en');
                    btnEs.style.opacity = lang === 'es' ? '1' : '0.6';
                    btnEn.style.opacity = lang === 'en' ? '1' : '0.6';
                }

                // --- Guardar Idioma ---
                localStorage.setItem(storageKeys.language, lang);
            };

            // ============================================
            //   CARGA INICIAL DEL IDIOMA
            // ============================================
            const savedLanguage = localStorage.getItem(storageKeys.language);
            const initialLang = (savedLanguage === 'es' || savedLanguage === 'en') ? savedLanguage : 'en';
            window.changeLanguage(initialLang);

        });
    </script>
</head>
<body>
    <!-- Incluir Navbar (Asegúrate que el partial exista y funcione) -->
    <%- include('partials/navbar') %>

    <!-- Selector de Idioma (Fijo y Estilizado) -->
    <div class="language-switcher">
        <button id="btn-es" class="lang-btn" onclick="changeLanguage('es')">
            <span>SP</span>
        </button>
        <div class="separator"></div>
        <button id="btn-en" class="lang-btn" onclick="changeLanguage('en')">
            <span>EN</span>
        </button>
    </div>

    <!-- Contenido Principal del Onboarding -->
    <div class="onboarding-background">
      <div class="onboarding-container">

        <!-- Encabezado (Se llena con JS) -->
        <header>
          <h1 id="main-heading">
             <!-- El JS lo llenará al cargar -->
          </h1>
        </header>

        <!-- Pasos del Onboarding (Acordeón) -->
        <main class="onboarding-content">

          <!-- Paso 1 -->
          <section class="onboarding-step" id="step-1-section">
            <div class="step-header" data-step="1">
              <span class="step-number">1</span>
              <h2 id="step1-title" class="step-title"></h2> <!-- JS llenará -->
              <span class="step-icon"><i class="fas fa-chevron-right"></i></span>
              <input type="checkbox" class="completion-checkbox" aria-label="Mark step 1 as complete">
            </div>
            <div class="step-body">
                <div class="step-body-content">
                    <p id="step1-intro"></p> <!-- JS llenará -->
                    <ol id="step1-list"></ol> <!-- JS llenará -->
                    <p><a id="tutorial-link-1" href="#REEMPLAZAR_CON_URL_VIDEO_1" class="tutorial-link"></a></p> <!-- JS llenará -->
                </div>
            </div>
          </section>

          <!-- Paso 2 -->
           <section class="onboarding-step" id="step-2-section">
            <div class="step-header" data-step="2">
              <span class="step-number">2</span>
              <h2 id="step2-title" class="step-title"></h2> <!-- JS llenará -->
              <span class="step-icon"><i class="fas fa-chevron-right"></i></span>
              <input type="checkbox" class="completion-checkbox" aria-label="Mark step 2 as complete">
            </div>
            <div class="step-body">
                 <div class="step-body-content">
                    <p id="step2-intro"></p> <!-- JS llenará -->
                    <ul id="step2-list" class="feature-list"></ul> <!-- JS llenará -->
                    <p><a id="tutorial-link-2" href="#REEMPLAZAR_CON_URL_VIDEO_2" class="tutorial-link"></a></p> <!-- JS llenará -->
                </div>
            </div>
          </section>

          <!-- Paso 3 -->
          <section class="onboarding-step" id="step-3-section">
            <div class="step-header" data-step="3">
               <span class="step-number">3</span>
              <h2 id="step3-title" class="step-title"></h2> <!-- JS llenará -->
               <span class="step-icon"><i class="fas fa-chevron-right"></i></span>
               <input type="checkbox" class="completion-checkbox" aria-label="Mark step 3 as complete">
            </div>
             <div class="step-body">
                 <div class="step-body-content">
                     <p id="step3-intro"></p> <!-- JS llenará -->
                     <ul id="step3-list" class="feature-list"></ul> <!-- JS llenará -->
                     <p><a id="tutorial-link-3" href="#REEMPLAZAR_CON_URL_VIDEO_3" class="tutorial-link"></a></p> <!-- JS llenará -->
                 </div>
             </div>
          </section>

        </main>

        <!-- Pie de Página (Simplificado: solo el CTA) -->
        <footer class="onboarding-footer fade-in" style="animation-delay: 0.6s;">
            <p id="footer-cta" class="cta-footer"></p> <!-- JS llenará -->
        </footer>

      </div> <!-- Fin .onboarding-container -->
    </div> <!-- Fin .onboarding-background -->
</body>
</html>