<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados de Envío | Hunter IO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/navbar.css">
    <link rel="stylesheet" href="/static/css/onboarding.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="container mt-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Resultados de Envío</h4>
            </div>
            <div class="card-body">
                
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>
                
                <% if (username) { %>
                    <div class="alert alert-info">
                        <strong><i class="fas fa-user-circle me-2"></i> Cuenta origen:</strong> @<%= username %>
                        <br>
                        <strong><i class="fas fa-comment-dots me-2"></i> Fuente de mensajes:</strong> <%= messageSource %>
                    </div>
                <% } %>
                
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cuenta</th>
                                <th>Estado</th>
                                <th>Mensaje Enviado</th>
                                <th>Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% results.forEach(result => { %>
                                <tr class="<%= result.status === 'success' ? 'table-success' : 'table-danger' %>">
                                    <td>@<%= result.user %></td>
                                    <td>
                                        <% if (result.status === 'success') { %>
                                            <span class="badge bg-success rounded-pill">
                                                <i class="fas fa-check me-1"></i> Éxito
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-danger rounded-pill">
                                                <i class="fas fa-times me-1"></i> Error
                                            </span>
                                        <% } %>
                                    </td>
                                    <td><%= result.sentMessage || 'N/A' %></td>
                                    <td><small><%= result.message %></small></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                
                <div class="d-flex justify-content-between mt-4">
                    <a href="/instagram" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i> Volver a enviar
                    </a>
                    <a href="/profile" class="btn btn-primary">
                        <i class="fas fa-cog me-2"></i> Gestionar mensajes
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Font Awesome para íconos -->
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>