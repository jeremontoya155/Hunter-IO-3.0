<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Campañas</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .campaign-card {
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .campaign-active {
            border-left: 5px solid green;
        }
        .campaign-paused {
            border-left: 5px solid orange;
        }
        .campaign-completed {
            border-left: 5px solid gray;
        }
        .stats-card {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Gestión de Campañas</h1>
        
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <!-- Estadísticas rápidas -->
        <div class="row">
            <div class="col-md-3">
                <div class="stats-card">
                    <h5>Total Campañas</h5>
                    <h3><%= stats.total_campaigns %></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <h5>Activas</h5>
                    <h3><%= stats.active_campaigns %></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <h5>Pausadas</h5>
                    <h3><%= stats.paused_campaigns %></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <h5>Completadas</h5>
                    <h3><%= stats.completed_campaigns %></h3>
                </div>
            </div>
        </div>

        <!-- Botón para nueva campaña -->
        <button class="btn btn-primary mb-3" data-toggle="modal" data-target="#newCampaignModal">
            Crear Nueva Campaña
        </button>

        <!-- Lista de campañas -->
        <div class="campaigns-list">
            <% campaigns.forEach(campaign => { %>
                <div class="campaign-card campaign-<%= campaign.status %>">
                    <h3><%= campaign.name %></h3>
                    <p><%= campaign.description %></p>
                    <p><strong>Estado:</strong> 
                        <span class="badge badge-<%= 
                            campaign.status === 'active' ? 'success' : 
                            campaign.status === 'paused' ? 'warning' : 'secondary' 
                        %>">
                            <%= campaign.status === 'active' ? 'Activa' : 
                                campaign.status === 'paused' ? 'Pausada' : 'Completada' %>
                        </span>
                    </p>
                    <p><strong>Cuenta:</strong> <%= campaign.insta_account %></p>
                    <p><strong>Fecha Inicio:</strong> <%= new Date(campaign.start_date).toLocaleDateString() %></p>
                    <p><strong>Fecha Fin:</strong> <%= new Date(campaign.end_date).toLocaleDateString() %></p>
                    <p><strong>Mensajes/día:</strong> <%= campaign.daily_messages_limit %></p>
                    
                    <div class="campaign-actions">
                        <% if (campaign.status === 'active') { %>
                            <button class="btn btn-warning btn-sm pause-campaign" data-id="<%= campaign.id %>">
                                Pausar
                            </button>
                        <% } else if (campaign.status === 'paused') { %>
                            <button class="btn btn-success btn-sm resume-campaign" data-id="<%= campaign.id %>">
                                Reanudar
                            </button>
                        <% } %>
                        <button class="btn btn-info btn-sm view-stats" data-id="<%= campaign.id %>">
                            Ver Estadísticas
                        </button>
                    </div>
                    
                    <!-- Gráfico para esta campaña (se llenará con JS) -->
                    <div class="mt-3" style="height: 200px;">
                        <canvas id="chart-<%= campaign.id %>"></canvas>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <!-- Modal para nueva campaña -->
    <div class="modal fade" id="newCampaignModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva Campaña</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="newCampaignForm">
                        <div class="form-group">
                            <label>Nombre de la Campaña</label>
                            <input type="text" class="form-control" name="name" required>
                        </div>
                        <div class="form-group">
                            <label>Descripción</label>
                            <textarea class="form-control" name="description" rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Cuenta de Instagram</label>
                            <select class="form-control" name="insta_account" required>
                                <% user.accounts.forEach(account => { %>
                                    <option value="<%= account.insta_username %>">
                                        <%= account.insta_username %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Fecha de Inicio</label>
                            <input type="date" class="form-control" name="start_date" required>
                        </div>
                        <div class="form-group">
                            <label>Fecha de Fin</label>
                            <input type="date" class="form-control" name="end_date" required>
                        </div>
                        <div class="form-group">
                            <label>Mensajes por día</label>
                            <input type="number" class="form-control" name="daily_messages_limit" min="1" required>
                        </div>
                        <div class="form-group">
                            <label>Estado</label>
                            <select class="form-control" name="status">
                                <option value="active">Activa</option>
                                <option value="paused">Pausada</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="saveCampaignBtn">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para estadísticas -->
    <div class="modal fade" id="statsModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Estadísticas de Campaña</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="statsContent"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Configurar fecha mínima para los inputs de fecha (hoy)
        document.querySelector('input[name="start_date"]').min = new Date().toISOString().split('T')[0];
        document.querySelector('input[name="end_date"]').min = new Date().toISOString().split('T')[0];
        
        // Guardar nueva campaña
        document.getElementById('saveCampaignBtn').addEventListener('click', async () => {
            const form = document.getElementById('newCampaignForm');
            const formData = new FormData(form);
            
            try {
                const response = await fetch('/campaigns', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(Object.fromEntries(formData))
                });
                
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Error al crear la campaña');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al crear la campaña');
            }
        });

        // Pausar/reanudar campaña
        document.querySelectorAll('.pause-campaign, .resume-campaign').forEach(btn => {
            btn.addEventListener('click', async () => {
                const campaignId = btn.dataset.id;
                const newStatus = btn.classList.contains('pause-campaign') ? 'paused' : 'active';
                
                try {
                    const response = await fetch(`/campaigns/${campaignId}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            status: newStatus
                        })
                    });
                    
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Error al actualizar la campaña');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error al actualizar la campaña');
                }
            });
        });

        // Ver estadísticas
        document.querySelectorAll('.view-stats').forEach(btn => {
            btn.addEventListener('click', async () => {
                const campaignId = btn.dataset.id;
                
                try {
                    const response = await fetch(`/campaigns/${campaignId}/stats`);
                    const data = await response.json();
                    
                    if (response.ok) {
                        // Mostrar estadísticas en el modal
                        const statsContent = document.getElementById('statsContent');
                        statsContent.innerHTML = `
                            <h4>${data.campaign.name}</h4>
                            <p>${data.campaign.description}</p>
                            
                            <div class="row mt-4">
                                <div class="col-md-4">
                                    <div class="stats-card">
                                        <h5>Mensajes Enviados</h5>
                                        <h3>${data.stats.total_messages}</h3>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="stats-card">
                                        <h5>Respuestas Recibidas</h5>
                                        <h3>${data.stats.total_replies}</h3>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="stats-card">
                                        <h5>Tasa de Respuesta</h5>
                                        <h3>${data.stats.reply_rate}%</h3>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mt-4" style="height: 300px;">
                                <canvas id="statsChart"></canvas>
                            </div>
                        `;
                        
                        // Mostrar gráfico
                        const ctx = document.getElementById('statsChart').getContext('2d');
                        new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: data.stats.messages_by_day.map(item => item.date),
                                datasets: [{
                                    label: 'Mensajes por día',
                                    data: data.stats.messages_by_day.map(item => item.count),
                                    backgroundColor: 'rgba(54, 162, 235, 0.5)',
                                    borderColor: 'rgba(54, 162, 235, 1)',
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: true,
                                scales: {
                                    y: {
                                        beginAtZero: true
                                    }
                                }
                            }
                        });
                        
                        // Mostrar modal
                        $('#statsModal').modal('show');
                    } else {
                        alert('Error al obtener estadísticas');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error al obtener estadísticas');
                }
            });
        });

        // Inicializar gráficos de campañas
        document.addEventListener('DOMContentLoaded', () => {
            <% campaigns.forEach(campaign => { %>
                const ctx<%= campaign.id %> = document.getElementById('chart-<%= campaign.id %>').getContext('2d');
                // Aquí podrías hacer una llamada AJAX para obtener datos específicos de cada campaña
                // y mostrar un gráfico más detallado
            <% }); %>
        });
    </script>
</body>
</html>