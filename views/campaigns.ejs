<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Campañas</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/static/css/navbar.css" />
    <link rel="stylesheet" href="/static/css/campaigns.css" />
    <link rel="stylesheet" href="/static/css/scrollbar.css" />
    <link rel="stylesheet" href="/static/css/all.css" />

    <script src="/static/js/navbar.js" defer></script>
  </head>
  <body>
    <%- include('partials/navbar') %>
        <!-- Selector de Idioma -->
    <div class="language-switcher">
      <button id="btn-es" class="lang-btn active" onclick="changeLanguage('es')">
        <span>SP</span>
      </button>
      <div class="separator"></div>
      <button id="btn-en" class="lang-btn" onclick="changeLanguage('en')">
        <span>EN</span>
      </button>
    </div>

    <div class="container">
      <div class="header">
        <h1><i class="fas fa-bullhorn"></i> <span data-translate-key="campaignTitle">Gestión de Campañas</span></h1>
        <p data-translate-key="campaignSubtitle">Administra y monitorea tus campañas de marketing</p>
      </div>

      <% if (success) { %>
      <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> <%= success %>
      </div>
      <% } %> <% if (error) { %>
      <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> <%= error %>
      </div>
      <% } %>

      <div class="stats-grid">
        <div class="stats-card">
          <div class="icon"><i class="fas fa-chart-line"></i></div>
          <h3><%= stats.total_campaigns %></h3>
          <h5 data-translate-key="totalCampaigns">Total Campañas</h5>
        </div>
        <div class="stats-card">
          <div class="icon"><i class="fas fa-play-circle"></i></div>
          <h3><%= stats.active_campaigns %></h3>
          <h5 data-translate-key="activeCampaigns">Activas</h5>
        </div>
        <div class="stats-card">
          <div class="icon"><i class="fas fa-pause-circle"></i></div>
          <h3><%= stats.paused_campaigns %></h3>
          <h5 data-translate-key="pausedCampaigns">Pausadas</h5>
        </div>
        <div class="stats-card">
          <div class="icon"><i class="fas fa-check-circle"></i></div>
          <h3><%= stats.completed_campaigns %></h3>
          <h5 data-translate-key="completedCampaigns">Completadas</h5>
        </div>
      </div>

      <div class="campaigns-header-bar">
        <button
          class="btn-primary-custom"
          onclick="openModal('newCampaignModal')"
        >
          <i class="fas fa-plus"></i> <span data-translate-key="newCampaignBtn">Nueva Campaña</span>
        </button>

        <div class="campaigns-filters">
          <input
            type="text"
            class="form-control search-input"
            data-translate-key="searchPlaceholder"
            placeholder="Buscar por nombre o cuenta..."
            oninput="filterCampaigns()"
          />
          <input
            type="date"
            class="form-control date-filter"
            onchange="filterCampaigns()"
            id="filter-date"
          />
        </div>
      </div>

      <!-- Nueva tabla de campañas -->
      <div class="campaigns-table-wrapper">
        <table class="campaigns-table">
          <thead>
            <tr>
              <th data-translate-key="nameCol">Nombre</th>
              <th data-translate-key="accountCol">Cuenta</th>
              <th data-translate-key="startCol">Inicio</th>
              <th data-translate-key="endCol">Fin</th>
              <th data-translate-key="limitCol">Mensajes/día</th>
              <th data-translate-key="statusCol">Estado</th>
              <th data-translate-key="actionsCol">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% campaigns.forEach(c => { %>
            <tr class="campaign-row campaign-<%= c.status %>">
              <td>
                <strong><%= c.name %></strong><br /><small
                  ><%= c.description %></small
                >
              </td>
              <td><%= c.insta_account %></td>
              <td><%= new Date(c.start_date).toLocaleDateString() %></td>
              <td><%= new Date(c.end_date).toLocaleDateString() %></td>
              <td><%= c.daily_messages_limit %></td>
              <td>
                <% const statusMap = {
                  active: { key: 'statusActive', label: 'Activa' },
                  paused: { key: 'statusPaused', label: 'Pausada' },
                  completed: { key: 'statusCompleted', label: 'Completada' }
                }; %>

                <% const currentStatus = statusMap[c.status] || statusMap['completed']; %>

                <span
                  class="badge badge-<%= c.status === 'active' ? 'success' : c.status === 'paused' ? 'warning' : 'secondary' %>"
                  data-translate-key="<%= currentStatus.key %>"
                >
                  <%= currentStatus.label %>
                </span>

              </td>
              <td>
                <% if (c.status === 'active') { %>
                <button
                  class="btn btn-warning btn-sm pause-campaign"
                  data-id="<%= c.id %>"
                >
                  <i class="fas fa-pause"></i>
                </button>
                <% } else if (c.status === 'paused') { %>
                <button
                  class="btn btn-success btn-sm resume-campaign"
                  data-id="<%= c.id %>"
                >
                  <i class="fas fa-play"></i>
                </button>
                <% } %>
                <button
                  class="btn btn-info btn-sm view-stats"
                  data-id="<%= c.id %>"
                >
                  <i class="fas fa-chart-bar"></i>
                </button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal para nueva campaña -->
    <div class="modal" id="newCampaignModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">
              <i class="fas fa-plus-circle"></i> <span data-translate-key="modalNewTitle">Nueva Campaña</span>
            </h5>
            <button
              type="button"
              class="close"
              onclick="closeModal('newCampaignModal')"
            >
              <span>&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <form id="newCampaignForm">
              <div class="form-group">
                <label><i class="fas fa-tag"></i> <span data-translate-key="nameLabel">Nombre de la Campaña</span></label>
                <input
                  type="text"
                  class="form-control"
                  name="name"
                  data-translate-key="namePlaceholder"
                  placeholder="Ej: Campaña Verano 2024"
                  required
                />
              </div>
              <div class="form-group">
                <label><i class="fas fa-align-left"></i> <span data-translate-key="descLabel">Descripción</span></label>
                <textarea
                  class="form-control"
                  name="description"
                  rows="3"
                  data-translate-key="descPlaceholder"
                  placeholder="Describe el objetivo de tu campaña..."
                ></textarea>
              </div>
              <div class="form-group">
                <label
                  ><i class="fab fa-instagram"></i> <span data-translate-key="instaLabel">Cuenta de Instagram</span></label
                >
                <select class="form-control" name="insta_account" required>
                  <option value="" data-translate-key="instaPlaceholder">Selecciona una cuenta</option>
                  <% user.accounts.forEach(account => { %>
                  <option value="<%= account.insta_username %>">
                    <%= account.insta_username %>
                  </option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label
                  ><i class="fas fa-calendar-alt"></i> <span data-translate-key="startDateLabel">Fecha de Inicio</span></label
                >
                <input
                  type="date"
                  class="form-control"
                  name="start_date"
                  required
                />
              </div>
              <div class="form-group">
                <label
                  ><i class="fas fa-calendar-check"></i> <span data-translate-key="endDateLabel">Fecha de Fin</span></label
                >
                <input
                  type="date"
                  class="form-control"
                  name="end_date"
                  required
                />
              </div>
              <div class="form-group">
                <label><i class="fas fa-envelope"></i> <span data-translate-key="limitLabel">Mensajes por día</span></label>
                <input
                  type="number"
                  class="form-control"
                  name="daily_messages_limit"
                  min="1"
                  max="100"
                  data-translate-key="limitPlaceholder"
                  placeholder="Ej: 50"
                  required
                />
              </div>
              <div class="form-group">
                <label><i class="fas fa-toggle-on"></i> <span data-translate-key="stateLabel">Estado</span></label>
                <select class="form-control" name="status">
                  <option value="active" data-translate-key="optionActive">Activa</option>
                  <option value="paused" data-translate-key="optionPaused">Pausada</option>
                </select>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              onclick="closeModal('newCampaignModal')"
            >
              <i class="fas fa-times"></i> <span data-translate-key="cancelBtn">Cancelar</span>
            </button>
            <button type="button" class="btn btn-success" id="saveCampaignBtn">
              <i class="fas fa-save"></i> <span data-translate-key="saveBtn">Guardar Campaña</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal para estadísticas -->
    <div class="modal" id="statsModal">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">
              <i class="fas fa-chart-line"></i> <span data-translate-key="statsModalTitle">Estadísticas de Campaña</span>
            </h5>
            <button
              type="button"
              class="close"
              onclick="closeModal('statsModal')"
            >
              <span>&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <div id="statsContent"></div>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              onclick="closeModal('statsModal')"
            >
              <i class="fas fa-times"></i> <span data-translate-key="closeBtn">Cerrar</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <script type="module" src="/static/js/languagesDefine/campaignLang.js"></script>
    <script defer src="/static/js/campaigns.js"></script>
  </body>
</html>
