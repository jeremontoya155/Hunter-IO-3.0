<!DOCTYPE html>
<html lang="en"> <!-- Default language set to English -->
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Title will be set dynamically by JS -->
    <title>Performance Dashboard - <%= username %></title>

    <!-- Tailwind (opcional si CSS custom domina) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Estilos personalizados -->
   
    <link rel="stylesheet" href="/static/css/scrollbar.css" />
    <link rel="stylesheet" href="/static/css/navbar.css" />
        <!-- <link rel="stylesheet" href="/static/css/all.css" /> -->
        <link rel="stylesheet" href="/static/css/variables.css" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->

    
     <link rel="stylesheet" href="/static/css/resumen.css" />
</head>
<body> <!-- Clases base movidas a body -->
    <%- include('partials/navbar') %>

    <!-- Contenedor principal -->
     
    <div class="main-content">
        <header class="page-header">
            <div class="header-content">
                 <!-- Title structure for dynamic update -->
                <h1 class="text-2xl font-semibold">
                    <span data-translate-key="dashboardHeaderPrefix">Performance Dashboard</span>: <%= username %>
                </h1>
                <button id="langSwitchBtn" class="lang-switch-button" title="Change Language / Cambiar Idioma">EN / ES</button>
            </div>
        </header>
 
        <div class="dashboard-grid">
            <!-- Fila 2: Resumen General (Ocupa todo el ancho) -->
            <section class="key-metrics-section">
                    <h2 class="section-title"><i class="fas fa-tachometer-alt mr-2"></i><span data-translate-key="summaryTitle">General Summary</span></h2>
                    <div class="metrics-container">
                        <%
                            let totalMensajes = parseInt(total_mensajes_enviados) || 0;
                            let totalLikesRecibidos = parseInt(total_likes) || 0;
                            let likeRate = totalMensajes > 0 ? (totalLikesRecibidos / totalMensajes) * 100 : 0;
                            let likeRateFormatted = likeRate.toFixed(1) + '%';
                            let efectividadClass = '';
                            if (likeRate < 10) { efectividadClass = 'alert-low'; }
                            else if (likeRate < 20) { efectividadClass = 'alert-medium'; }
                            else if (likeRate < 30) { efectividadClass = 'alert-good'; }
                            else { efectividadClass = 'alert-excellent'; }
                        %>
                        <div class="metric-card">
                            <h3 class="metric-title" data-translate-key="messagesSent">Messages Sent</h3>
                            <p class="metric-value"><%= totalMensajes %></p>
                            <i class="fas fa-paper-plane metric-icon"></i>
                        </div>
                        <div class="metric-card">
                            <h3 class="metric-title" data-translate-key="likesReceived">"Likes" Received</h3>
                            <p class="metric-value"><%= totalLikesRecibidos %></p>
                            <i class="fas fa-thumbs-up metric-icon"></i>
                        </div>
                        <div class="metric-card <%= efectividadClass %>">
                            <h3 class="metric-title" data-translate-key="likeRateProxy">Like Rate (Proxy)</h3>
                            <p class="metric-value"><%= likeRateFormatted %></p>
                            <i class="fas fa-chart-line metric-icon"></i>
                            <span class="metric-note" data-translate-key="likeRateNote">Based on Likes / Messages Sent</span>
                        </div>
                        <div class="metric-card metric-card-small">
                            <h3 class="metric-title-small" data-translate-key="lastMessageSimple">Last Message</h3>
                            <!-- Mostrar fecha/hora completa aquí, ya que es un resumen -->
                            <% const fechaObj = new Date(fechaUltimoMensaje); %>
                            <p class="metric-value-small">
                            <span><%= fechaObj.toLocaleDateString('es-AR', { day: 'numeric', month: 'long' }) %></span>
                            <span><%= fechaObj.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) %></span>
                            </p>

                            <p class="metric-detail-small"><span data-translate-key="toRecipient">To</span><%= destinatarioUltimo %></p>
                        </div>
                    </div>
                </section>

                <section class="filter-section card">
                    <div class="titleSection"><h2 class="card-title"><i class="fas fa-filter mr-2"></i> Filters</h2></div>
                    <div class="filter-controls">
                        <div class="filter-control-row">

                            <div class="filter-control-group">
                                <label for="accountSelector" data-translate-key="accountLabel">Account:</label>
                                <select id="accountSelector" name="account">
                                    <option value="" <%= !selectedAccount ? 'selected' : '' %> data-translate-key="allAccountsOption">All Accounts</option>
                                    <% userAccounts.forEach(ac => { %>
                                    <option value="<%= ac.insta_username %>" <%= selectedAccount === ac.insta_username ? 'selected' : '' %>>
                                        <%= ac.insta_username %>
                                    </option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>

                        <div class="filter-control-row">
                            <div class="filter-control-group">
                                <label for="fromDate" data-translate-key="fromLabel">From:</label>
                                <input type="date" id="fromDate" name="fromDate" value="<%= fromDate %>">
                            </div>
                            <div class="filter-control-group">
                                <label for="toDate" data-translate-key="toLabel">To:</label>
                                <input type="date" id="toDate" name="toDate" value="<%= toDate %>">
                            </div>
                        </div>

                        <button id="btnFiltrar" class="filter-button">
                            <i class="fas fa-search"></i>
                            <span data-translate-key="filterButton">Filter</span>
                        </button>
                    </div>
                </section>


                <section class="card campaigns-summary">
                    <div class="titleSection">
                            <h2 class="card-title"><i class="fas fa-bullhorn"></i> <span data-translate-key="campanasTitle">Campañas Activas</span></h2>
                        </div>
                    <div class="active-campaigns-scroll">
                        <% campaigns.filter(c => c.status === 'active').forEach(c => { %>
                        <div class="active-campaign-card">
                            <div class="active-campaign-info">
                            <div class="active-campaign-name"><%= c.name %></div>
                            <div class="active-campaign-meta">
                                <span><i class="fas fa-user"></i> <%= c.insta_account %></span>
                                <span><i class="fas fa-calendar-alt"></i> <%= new Date(c.start_date).toLocaleDateString() %> - <%= new Date(c.end_date).toLocaleDateString() %></span>
                                <span><i class="fas fa-envelope"></i> <%= c.daily_messages_limit %>/día</span>
                            </div>
                            <div class="active-campaign-badge" data-translate-key="activeBadge">Activa</div>
                            </div>
                        </div>
                        <% }) %>
                        <% if (campaigns.filter(c => c.status === 'active').length === 0) { %>
                        <div class="active-campaign-card no-active-campaigns">
                            <p data-translate-key="noCampaignsBadge">No hay campañas activas</p>
                        </div>
                        <% } %>
                    </div>
                    <div class="campaigns-link-bottom">
                        <a href="/campaigns" class="btn btn-primary-custom" data-translate-key="seeAllBadge">Ver todas</a>
                    </div>
                </section>

                <!-- Fila 3: Gráfico (Ocupa todo el ancho) -->
                <section class="chart-section card">
                    <h2 class="card-title"><i class="fas fa-chart-line mr-2"></i><span data-translate-key="activityChartTitle">Activity per Day</span></h2>
                    <div class="chart-container">
                        <canvas id="graficoMensajes"></canvas>
                        <!-- Placeholder text will be managed by JS -->
                    </div>
                </section>

                <!-- Fila 4 (lg+): Contenido Último Mensaje | Mensajes por Tipo -->
                <section class="last-message-section card">
                    <h2 class="card-title"><i class="fas fa-envelope-open-text mr-2"></i><span data-translate-key="lastMessageContentTitle">Last Message Content</span></h2>
                    <% if (ultimoMensaje) { %>
                        <p class="last-message-content"><%= ultimoMensaje %></p>
                        <span class="last-message-recipient"><span data-translate-key="toRecipient">To</span>: <%= destinatarioUltimo %></span>
                    <% } else { %>
                        <p class="no-messages" data-translate-key="noLastMessage">No last message to display.</p>
                    <% } %>
                </section>

            <section class="message-types-section card">
                    <h2 class="card-title"><i class="fas fa-tags mr-2"></i><span data-translate-key="messagesByTypeTitle">Messages by Type</span></h2>
                    <div class="types-container">
                        <div class="type-item">
                            <span class="type-label" data-translate-key="messageTypeCom">Communication:</span>
                            <span class="type-value"><%= mensajesPorTipo.comunicacion %></span>
                        </div>
                        <div class="type-item">
                            <span class="type-label" data-translate-key="messageTypeSale">Sale:</span>
                            <span class="type-value"><%= mensajesPorTipo.venta %></span>
                        </div>
                        <div class="type-item">
                            <span class="type-label" data-translate-key="messageTypeImp">Imperative:</span>
                            <span class="type-value"><%= mensajesPorTipo.imperativo %></span>
                        </div>
                    </div>
            </section>

                    <!-- Fila 1 (lg+): Filtros | Últimos Mensajes Enviados -->


            <section class="recent-messages-section card">
                <h2 class="card-title"><i class="fas fa-history mr-2"></i><span data-translate-key="recentMessagesTitle">Recent Messages Sent</span></h2>
                <div id="mensajesSend" class="messages-list">
                    <% if (ultimos_mensajes && ultimos_mensajes.length > 0) { %>
                        <% const mensajesLimitados = ultimos_mensajes.slice(0, 10); %>
                        <% mensajesLimitados.forEach(function(mensaje) { %>
                            <%
                                const fechaHoraCompleta = mensaje.fecha || '';
                                const partes = fechaHoraCompleta.split(' ');
                                const fechaParte = partes[0] || '';
                                const horaParte = (partes[1] || '').split('.')[0]; // Tomar solo HH:MM:SS si hay milisegundos
                            %>
                            <div class="mensaje-item">
                                <div class="mensaje-header">
                                    <span class="mensaje-destinatario"><i class="fas fa-user mr-1"></i> <%= mensaje.destinatario %></span>
                                    <div class="mensaje-fecha-hora">
                                        <span class="mensaje-fecha-parte"><%= fechaParte %></span>
                                        <span class="mensaje-hora-parte"><%= horaParte %></span>
                                    </div>
                                </div>
                                <% if (mensaje.mensaje) { %>
                                    <p class="mensaje-contenido"><%= mensaje.mensaje %></p>
                                <% } %>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-messages" data-translate-key="noRecentMessages">No recent messages to display.</p>
                    <% } %>
                </div>
            </section>

        </div> <!-- Fin de dashboard-grid -->
    </div> <!-- Fin de main-content -->

    <!-- Chart.JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
    <!-- Scripts -->
    <script src="/static/js/navbar.js"></script> <!-- Asumiendo que existe y es necesario -->
    <script type="module" src="/static/js/resumen.js"></script>
</body>
</html>